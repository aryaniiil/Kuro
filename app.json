{
  "expo": {
    "name": "Kuro",
    "slug": "kuro",
    "scheme": "kuroapp",
    "version": "1.0.0",
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-font"
    ],
    "orientation": "portrait",
    "icon": "./assets/appico.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/appico.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/appico.png",
        "backgroundColor": "#09090b"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aryaniiil.kuro"
    },
    "web": {
      "favicon": "./assets/logo.png"
    }
  }
}
